{
  "schema": "lilypatch.text.v1",
  "target_id": "th09_150a",
  "resource": "pl07_match.msg",
  "entries": {
    "0/50_0": {
      "original_lines": [
        "巫女巫女レイムッ",
        "巫女巫女レイム～♪"
      ],
      "translated_lines": [
        "巫女巫女灵梦~",
        "巫女巫女灵梦～♪"
      ]
    },
    "1/50_0": {
      "original_lines": [
        "神社は赤色、外れ者～♪",
        "夕日が沈む～また沈む～♪"
      ],
      "translated_lines": [
        "神社乃赤色，脱离者～♪",
        "夕阳正西下～依旧西下～♪"
      ]
    },
    "10/50_0": {
      "original_lines": [
        "黒い人間、何故黒い～♪",
        "おっなかかなぁ？　おっなかだねぇ♪"
      ],
      "translated_lines": [
        "黑色的人，为什么黑～♪",
        "是因为肚子吗？　是因为肚子吧♪"
      ]
    },
    "11/50_0": {
      "original_lines": [
        "あっかるーい、なっしょなー♪",
        "地球の光～、レーザーの光～♪"
      ],
      "translated_lines": [
        "明亮的，世界的~♪",
        "地球之光～，镭射之光～♪"
      ]
    },
    "20/50_0": {
      "original_lines": [
        "メイドといえばメイドさん～",
        "略してメイド～♪"
      ],
      "translated_lines": [
        "说起女仆就是女仆小姐～",
        "略称女仆～♪"
      ]
    },
    "21/50_0": {
      "original_lines": [
        "おなかが空いたらメイドさん～♪",
        "略してメイド～♪"
      ],
      "translated_lines": [
        "肚子饿了的话女仆小姐～♪",
        "略称女仆～♪"
      ]
    },
    "30/50_0": {
      "original_lines": [
        "もういーくつ寝るとーおそうしーきー♪"
      ],
      "translated_lines": [
        "再一直～睡的话～就给你～办葬礼～♪"
      ]
    },
    "40/50_0": {
      "original_lines": [
        "かーごめかごめ。",
        "カーゴのなーかの密入国♪"
      ],
      "translated_lines": [
        "笼子~笼子~",
        "笼子里的~偷渡客♪"
      ]
    },
    "50/50_0": {
      "original_lines": [
        "妖精はお呼びでない"
      ],
      "translated_lines": [
        "没叫妖精来"
      ]
    },
    "51/50_0": {
      "original_lines": [
        "あんたに聞かせる歌は無いわ～"
      ],
      "translated_lines": [
        "没有给你听的歌啊～"
      ]
    },
    "60/50_0": {
      "original_lines": [
        "ソーレイがお空でソーラーレイ♪"
      ],
      "translated_lines": [
        "那就是天上的Solar Ray♪"
      ]
    },
    "70/50_0": {
      "original_lines": [
        "今日はユニゾン記念日よ～"
      ],
      "translated_lines": [
        "今天是齐唱纪念日哟～"
      ]
    },
    "80/50_0": {
      "original_lines": [
        "タラッタ、ラッタラッタ",
        "ウサギの哀愁漂う後ろ姿ー♪"
      ],
      "translated_lines": [
        "嗒啦嗒，啦嗒啦嗒",
        "兔子的充满哀愁的背影—♪"
      ]
    },
    "100/50_0": {
      "original_lines": [
        "しんぶんし～♪",
        "逆さから読むと哲学的な文様が！"
      ],
      "translated_lines": [
        "报纸~报纸～♪",
        "倒过来也能念的哲学性文字！"
      ]
    },
    "90/50_0": {
      "original_lines": [
        "お日様おやすみ向日葵回る～♪",
        "向日葵日雇いお日様沈む～♪"
      ],
      "translated_lines": [
        "太阳公公晚安向日葵绕弯弯～♪",
        "向日葵打短工太阳公公下山喽～♪"
      ]
    },
    "110/50_0": {
      "original_lines": [
        "人形一家だ、スーズランラン♪"
      ],
      "translated_lines": [
        "人偶一家铃铃兰兰♪"
      ]
    },
    "120/50_0": {
      "original_lines": [
        "さんんずのぉーわーたあし～♪"
      ],
      "translated_lines": [
        "人偶一家铃铃兰兰♪"
      ]
    },
    "210/50_0": {
      "original_lines": [
        "私の歌で惑わない人間は居ないわ！"
      ],
      "translated_lines": [
        "没有听了我的歌而不迷失心智的人！"
      ]
    },
    "211/50_0": {
      "original_lines": [
        "歌い手は喉が命",
        "でも、あんたは命取り"
      ],
      "translated_lines": [
        "歌手以喉为命，",
        "不过，你是要命的东西。"
      ]
    }
  }
}
