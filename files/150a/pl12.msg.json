{
  "schema": "lilypatch.text.v1",
  "target_id": "th09_150a",
  "resource": "pl12.msg",
  "entries": {
    "50/140_0": {
      "original_lines": [
        "この辺は変化は無いな。"
      ],
      "translated_lines": [
        "这附近没什么变化呢。"
      ]
    },
    "50/140_1": {
      "original_lines": [
        "あ、誰か来た！"
      ],
      "translated_lines": [
        "啊，有谁来了！"
      ]
    },
    "50/170_0": {
      "original_lines": [
        "見かけない奴ね。",
        "この辺で墜落していく？"
      ],
      "translated_lines": [
        "没见过的生面孔呢。",
        "要不要掉下湖去？"
      ]
    },
    "50/171_0": {
      "original_lines": [
        "そんなに暇はないんだけど……",
        "売られた喧嘩はこの世の華。"
      ],
      "translated_lines": [
        "我没空啦……",
        "挑衅就是这世界之花呢。"
      ]
    },
    "50/172_0": {
      "original_lines": [
        "お、やるかい？"
      ],
      "translated_lines": [
        "喔，要来吗？"
      ]
    },
    "51/50_0": {
      "original_lines": [
        "さてと、",
        "次の場所を見に行こう。"
      ],
      "translated_lines": [
        "好了，",
        "去看下一个地方吧。"
      ]
    },
    "52/50_0": {
      "original_lines": [
        "弱いね。",
        "まだ喧嘩のうちにも入らないよ。"
      ],
      "translated_lines": [
        "太弱了。",
        "你无法做我的对手。"
      ]
    },
    "40/140_0": {
      "original_lines": [
        "自殺する愚か者はいねーかねー"
      ],
      "translated_lines": [
        "有—没有—自杀的蠢材呢？"
      ]
    },
    "40/140_1": {
      "original_lines": [
        "って"
      ],
      "translated_lines": [
        "喂"
      ]
    },
    "40/170_0": {
      "original_lines": [
        "貴方はなまはげですか。"
      ],
      "translated_lines": [
        "你是生剥鬼吗？"
      ]
    },
    "40/171_0": {
      "original_lines": [
        "ちょっと様子を見に来ただけよ。"
      ],
      "translated_lines": [
        "我只是来看看状况啦。"
      ]
    },
    "40/172_0": {
      "original_lines": [
        "そう言って、仕事をサボっているのが",
        "バレバレよ。"
      ],
      "translated_lines": [
        "又这么说，其实就是在",
        "偷懒吧。"
      ]
    },
    "41/50_0": {
      "original_lines": [
        "少しくらい休憩しないと保たないじゃないか。",
        "死者の魂ばっか相手にしていると。"
      ],
      "translated_lines": [
        "要是不休息一下我可支持不下去呀。",
        "我的对手可全是死者的灵魂。"
      ]
    },
    "42/50_0": {
      "original_lines": [
        "自殺なんてしませんから、さっさと戻って",
        "自分の仕事をしてください。"
      ],
      "translated_lines": [
        "我不会自杀的啦，",
        "你还是快点回去工作吧。"
      ]
    },
    "80/140_0": {
      "original_lines": [
        "あら、いつぞやの毒兎。",
        "自殺の念は失せたか？"
      ],
      "translated_lines": [
        "啊，是那时的毒兔。",
        "放弃自杀的念头了吗？"
      ]
    },
    "80/140_1": {
      "original_lines": [
        "だーかーらー"
      ],
      "translated_lines": [
        "说过了啦—"
      ]
    },
    "80/170_0": {
      "original_lines": [
        "最初から自殺するなんて言ってないでしょ？"
      ],
      "translated_lines": [
        "从一开始我就没说要自杀啊？"
      ]
    },
    "80/171_0": {
      "original_lines": [
        "竹の花ももうすぐ散る。",
        "まぁ、気長に待ってくれ。"
      ],
      "translated_lines": [
        "竹花的花期也快完了。",
        "你就耐心等一下吧。"
      ]
    },
    "80/172_0": {
      "original_lines": [
        "もうすぐじゃないの？"
      ],
      "translated_lines": [
        "马上就要完了，不是吗？"
      ]
    },
    "81/50_0": {
      "original_lines": [
        "花が元に戻れば、自殺したがる者も減るだろう"
      ],
      "translated_lines": [
        "花恢复原状，自杀者也会减少吧。"
      ]
    },
    "82/50_0": {
      "original_lines": [
        "貴方が仕事をさぼっていたら、花は元通りに",
        "ならないんじゃないの？"
      ],
      "translated_lines": [
        "就因为你不工作，花才无法",
        "恢复原状的吧？"
      ]
    },
    "20/140_0": {
      "original_lines": [
        "この辺ももうすぐ元に戻るはず……",
        "って、結構多いな。幽霊。"
      ],
      "translated_lines": [
        "这附近应该恢复得差不多了吧……",
        "哇，还有这么多。幽灵。"
      ]
    },
    "20/140_1": {
      "original_lines": [
        "あー、"
      ],
      "translated_lines": [
        "啊—，"
      ]
    },
    "20/170_0": {
      "original_lines": [
        "また仕事をさぼってからに。",
        "貴方がさぼっていたら幽霊は減らないでしょ？"
      ],
      "translated_lines": [
        "又在偷懒了。",
        "你不工作的话，幽灵怎么能减少啊？"
      ]
    },
    "20/171_0": {
      "original_lines": [
        "あ、自殺せずに頑張っているね？"
      ],
      "translated_lines": [
        "啊，要坚强，不要自杀啊。"
      ]
    },
    "20/172_0": {
      "original_lines": [
        "しませんよ。",
        "そんな勿体ないこと。"
      ],
      "translated_lines": [
        "我才不会做",
        "这种傻事。"
      ]
    },
    "21/50_0": {
      "original_lines": [
        "あまりにも多すぎる仕事量を見ると、",
        "少し嫌になるな。"
      ],
      "translated_lines": [
        "看到有这么多工作量，",
        "有些讨厌呢。"
      ]
    },
    "22/50_0": {
      "original_lines": [
        "こんな所で油を売っていて良いのかしら？"
      ],
      "translated_lines": [
        "你在这里偷懒不大好吧？"
      ]
    },
    "30/140_0": {
      "original_lines": [
        "あの世は普通か……"
      ],
      "translated_lines": [
        "彼世很普通吗……"
      ]
    },
    "30/140_1": {
      "original_lines": [
        "あれ？"
      ],
      "translated_lines": [
        "咦？"
      ]
    },
    "30/170_0": {
      "original_lines": [
        "この間、あの世が大変になる、とか言っていま",
        "したが、まだ全然ですよ？"
      ],
      "translated_lines": [
        "你之前不是说过这里会有麻烦吗",
        "怎么一点迹象也没有啊？"
      ]
    },
    "30/171_0": {
      "original_lines": [
        "いや、あたいは頑張っている。",
        "頑張っているんだ。"
      ],
      "translated_lines": [
        "这个嘛，我正在努力啦。",
        "正在努力。"
      ]
    },
    "30/172_0": {
      "original_lines": [
        "あの世が忙しくない分にはいいんですけどね。"
      ],
      "translated_lines": [
        "虽然不忙是好事啦。"
      ]
    },
    "31/50_0": {
      "original_lines": [
        "いかん。",
        "こんな所で油を売っている場合ではない。"
      ],
      "translated_lines": [
        "不好。",
        "可不是在这里偷懒的时候。"
      ]
    },
    "32/50_0": {
      "original_lines": [
        "って、何で攻撃するのよー。",
        "そんなに暇なのかしら？"
      ],
      "translated_lines": [
        "为什么要攻击我啊—",
        "你就这么闲吗？"
      ]
    },
    "10/140_0": {
      "original_lines": [
        "竹の花も、もうすぐ見られなくなるんだ。",
        "今のうちに見ておこう。"
      ],
      "translated_lines": [
        "竹花的花期也快完了。",
        "趁现在去看吧。"
      ]
    },
    "10/140_1": {
      "original_lines": [
        "あれ？"
      ],
      "translated_lines": [
        "咦？"
      ]
    },
    "10/170_0": {
      "original_lines": [
        "サボタージュの泰斗じゃないか。",
        "どうした？　今日は。"
      ],
      "translated_lines": [
        "这不是罢工者的泰斗吗。",
        "今天是怎么了？"
      ]
    },
    "10/171_0": {
      "original_lines": [
        "誰がそんな呼び名を付けたのよ。"
      ],
      "translated_lines": [
        "是谁这样叫我的。"
      ]
    },
    "10/172_0": {
      "original_lines": [
        "私だ私。",
        "今付けたよ。"
      ],
      "translated_lines": [
        "是我啊。",
        "刚刚起的。"
      ]
    },
    "11/50_0": {
      "original_lines": [
        "ま、どんな巫山戯ていようとも、自らの",
        "気を鬱がないだけましだ。"
      ],
      "translated_lines": [
        "就算被取笑，也不要",
        "陷入忧郁。"
      ]
    },
    "11/51_0": {
      "original_lines": [
        "気を鬱げば、視野も塞がれる。",
        "それは、妬み、虚栄心を生み、"
      ],
      "translated_lines": [
        "陷入了忧郁，就会蒙蔽视野。",
        "从而心生妒忌和虚荣心，"
      ]
    },
    "11/52_0": {
      "original_lines": [
        "さらにそれすらも正当化する、",
        "心の狭い人間になるだろう。"
      ],
      "translated_lines": [
        "而且将此正当化，",
        "成为心胸狭窄的人类。"
      ]
    },
    "11/53_0": {
      "original_lines": [
        "気の鬱いだ人間は、いつの間にか",
        "孤立している事になるのだ。"
      ],
      "translated_lines": [
        "忧郁的人，迟早",
        "会被孤立。"
      ]
    },
    "11/54_0": {
      "original_lines": [
        "孤立を正当化するようになり、陰口を叩く様に",
        "なったらもう手に負えない。私は見捨てるよ。"
      ],
      "translated_lines": [
        "将孤立正当化，背地里说别人坏话的话",
        "那就没救了。我不会出手相救的。"
      ]
    },
    "11/55_0": {
      "original_lines": [
        "説教は別に良いけどさー、",
        "そんなに長時間サボっていて良いのか？"
      ],
      "translated_lines": [
        "说教是可以，",
        "但偷懒这么久真的好吗？"
      ]
    },
    "11/56_0": {
      "original_lines": [
        "おおっと。",
        "四季様の説教癖がうつってしまった。"
      ],
      "translated_lines": [
        "哎呀。",
        "不小心就惹上了四季大人的说教癖了。"
      ]
    },
    "12/50_0": {
      "original_lines": [
        "いいな。",
        "死神って仕事楽そうで。"
      ],
      "translated_lines": [
        "真好。",
        "做死神看来挺轻松的。"
      ]
    },
    "90/140_0": {
      "original_lines": [
        "って、ここは幽霊も花も全然改善",
        "されてない……"
      ],
      "translated_lines": [
        "啊，这里的幽灵和花一点",
        "都没有改善……"
      ]
    },
    "90/142_0": {
      "original_lines": [
        "マイペース。",
        "マイペース。"
      ],
      "translated_lines": [
        "慢慢来。",
        "慢慢来。"
      ]
    },
    "90/142_1": {
      "original_lines": [
        "あら、"
      ],
      "translated_lines": [
        "哎呀，"
      ]
    },
    "90/143_0": {
      "original_lines": [
        "まだサボっているのね。"
      ],
      "translated_lines": [
        "你又在偷懒了吧。"
      ]
    },
    "90/173_0": {
      "original_lines": [
        "こんな所にいたって、三途の川は遠いわよ？"
      ],
      "translated_lines": [
        "这里离三途河可是很远哦？"
      ]
    },
    "90/174_0": {
      "original_lines": [
        "よ、様子を見に来ただけだ。",
        "幽霊と花の様子を。"
      ],
      "translated_lines": [
        "我是来看看情况的啦。",
        "幽灵也好，花也好。"
      ]
    },
    "90/175_0": {
      "original_lines": [
        "様子を見ても仕事が進むわけではないでしょ？"
      ],
      "translated_lines": [
        "只看不做工作可不会进展啊？"
      ]
    },
    "90/176_0": {
      "original_lines": [
        "いや、仕事は慎重な方が良いんだ。"
      ],
      "translated_lines": [
        "这个嘛，工作还是谨慎些好。"
      ]
    },
    "90/177_0": {
      "original_lines": [
        "だから、夏までには向日葵に憑いた霊も彼岸に",
        "帰さないと、向日葵も疲れちゃうでしょう？"
      ],
      "translated_lines": [
        "但是，在夏天灵魂都附依在向日葵身上而",
        "过不了彼岸，向日葵可是很累的？"
      ]
    },
    "90/178_0": {
      "original_lines": [
        "大丈夫。",
        "夏までにはきっと終わるよ。"
      ],
      "translated_lines": [
        "不要紧。",
        "这个夏天内我会做完的。"
      ]
    },
    "90/179_0": {
      "original_lines": [
        "なんだか、貴方を見ていると誰かとイメージが",
        "被るのよね。"
      ],
      "translated_lines": [
        "看你这样子，总觉得有",
        "谁的影子。"
      ]
    },
    "90/180_0": {
      "original_lines": [
        "その、暢気さと仕事にいい加減な所が。"
      ],
      "translated_lines": [
        "一直很悠闲，工作也是慢吞吞的。"
      ]
    },
    "90/181_0": {
      "original_lines": [
        "誰が巫女なんだよ！"
      ],
      "translated_lines": [
        "谁是那种巫女啊！"
      ]
    },
    "90/182_0": {
      "original_lines": [
        "ああ、そうね。",
        "巫女と被るのよね。"
      ],
      "translated_lines": [
        "啊，对了。",
        "原来是像巫女啊。"
      ]
    },
    "90/141_0": {
      "original_lines": [
        "ま、少しづつ改善されるはず。"
      ],
      "translated_lines": [
        "嗯，一点一点地改善就好了。"
      ]
    },
    "91/50_0": {
      "original_lines": [
        "ここの向日葵に憑いた霊は陽気な霊ばかり",
        "だから、近いうちに死んだことに気付く。"
      ],
      "translated_lines": [
        "附依这里向日葵的灵魂都很有精神",
        "我觉得接近它们的我像死了一样。"
      ]
    },
    "91/51_0": {
      "original_lines": [
        "あら、そう言うものなの？",
        "陽気な方が死に気付きにくいかと思ったわ。"
      ],
      "translated_lines": [
        "哎呀，是这样吗？",
        "我倒是很难想像这么阳光的你会死。"
      ]
    },
    "91/52_0": {
      "original_lines": [
        "気が鬱いでない者は、視野が広いんだ。",
        "だから順応性も高い。"
      ],
      "translated_lines": [
        "没有忧郁的人们，视野也很广阔。",
        "适应性也很高。"
      ]
    },
    "91/53_0": {
      "original_lines": [
        "あ、俺死んでたんだ、あははー。",
        "って感じで死を受け入れるよ。"
      ],
      "translated_lines": [
        "啊，原来我死了啊，啊哈哈。",
        "就是这种感觉接受了死。"
      ]
    },
    "91/54_0": {
      "original_lines": [
        "それは陽気っていうか、頭悪そうね。"
      ],
      "translated_lines": [
        "那样与其说有精神，倒不如说头脑有问题。"
      ]
    },
    "92/50_0": {
      "original_lines": [
        "向日葵だって、咲きすぎると疲れちゃう",
        "じゃないの。"
      ],
      "translated_lines": [
        "向日葵开得太盛也会疲累的啊。"
      ]
    },
    "0/140_0": {
      "original_lines": [
        "さ、幻想郷の現状を色々と見てきたが、"
      ],
      "translated_lines": [
        "好了，虽然见到幻想乡的各种现状，"
      ]
    },
    "0/141_0": {
      "original_lines": [
        "まぁ何とかなるでしょ。"
      ],
      "translated_lines": [
        "总会有办法的啦。"
      ]
    },
    "0/142_0": {
      "original_lines": [
        "マイペース。",
        "マイペース。"
      ],
      "translated_lines": [
        "慢慢来。",
        "慢慢来。"
      ]
    },
    "0/142_1": {
      "original_lines": [
        "のんびりしてるわねぇ。"
      ],
      "translated_lines": [
        "你真是慢着来啊。"
      ]
    },
    "0/172_0": {
      "original_lines": [
        "幽霊の量は、全く減った感じが",
        "しないんだけどー。"
      ],
      "translated_lines": [
        "不过我感觉幽灵的份量",
        "一点也没减少。"
      ]
    },
    "0/173_0": {
      "original_lines": [
        "おお？",
        "また自殺しようってのか。"
      ],
      "translated_lines": [
        "喔喔？",
        "又有想自杀的吗。"
      ]
    },
    "0/174_0": {
      "original_lines": [
        "何度も言うが、今自殺したって誰の気にも",
        "留めないよ。"
      ],
      "translated_lines": [
        "我说过多次了，现在自杀谁也不会注意",
        "到你的。"
      ]
    },
    "0/175_0": {
      "original_lines": [
        "思い直せ。"
      ],
      "translated_lines": [
        "快点改变想法吧。"
      ]
    },
    "0/176_0": {
      "original_lines": [
        "誰が自殺するのよ。",
        "あんたは私に自殺して欲しいの？"
      ],
      "translated_lines": [
        "谁会自杀啊。",
        "你想我自杀吗？"
      ]
    },
    "0/177_0": {
      "original_lines": [
        "しないならいいけど、仕事の邪魔を",
        "しないでくれよ。"
      ],
      "translated_lines": [
        "不想就好了，那就不要妨碍我",
        "工作。"
      ]
    },
    "0/178_0": {
      "original_lines": [
        "仕事しているように見えないけどねぇ。"
      ],
      "translated_lines": [
        "我倒不觉得你是在工作。"
      ]
    },
    "0/179_0": {
      "original_lines": [
        "私は、あれから何時まで経っても花が",
        "元通りにならないから様子を見に来たの。"
      ],
      "translated_lines": [
        "花之异变一直没有",
        "结束，我才会过来看情况的。"
      ]
    },
    "0/180_0": {
      "original_lines": [
        "いい加減にしないと、また私がサボっている",
        "様に見られちゃうんだから。"
      ],
      "translated_lines": [
        "你不好好办事，我又会被说闲话",
        "不工作了。"
      ]
    },
    "0/181_0": {
      "original_lines": [
        "それはお前さんが、サボタージュの泰斗",
        "だからな。そのツケだ。"
      ],
      "translated_lines": [
        "那是因为你是罢工者的泰斗",
        "啊，有标签的。"
      ]
    },
    "0/182_0": {
      "original_lines": [
        "どっちがサボタージュなのよ。",
        "魔理沙みたいな事を言わないの！"
      ],
