{
  "schema": "lilypatch.text.v1",
  "target_id": "th09_150a",
  "resource": "pl07.msg",
  "entries": {
    "50/140_0": {
      "original_lines": [
        "生水飲むと～おなかを壊す～♪",
        "湖飲むと～三途河～♪"
      ],
      "translated_lines": [
        "喝凉水～坏肚子～♪",
        "喝湖水～三途河～♪"
      ]
    },
    "50/140_1": {
      "original_lines": [
        "なんだなんだ？"
      ],
      "translated_lines": [
        "怎么了怎么了？"
      ]
    },
    "50/170_0": {
      "original_lines": [
        "騒がしいのがやって来たね。"
      ],
      "translated_lines": [
        "吵人的家伙来了。"
      ]
    },
    "50/171_0": {
      "original_lines": [
        "もしかして妖精？",
        "私の歌は人間を呼ぶ為にあるのよ！"
      ],
      "translated_lines": [
        "你是妖精啊？",
        "我的歌是为了召唤出人类而存在的呢！"
      ]
    },
    "50/172_0": {
      "original_lines": [
        "湖の上で誰を呼ぼうとしたの！"
      ],
      "translated_lines": [
        "在湖面上想召唤谁啊！"
      ]
    },
    "51/50_0": {
      "original_lines": [
        "ここはハズレ。",
        "人間居ないし、余り楽しくない。"
      ],
      "translated_lines": [
        "不是这里。",
        "没有人在，一点意思都没有。"
      ]
    },
    "52/50_0": {
      "original_lines": [
        "最近みんなおかしいよ。",
        "春の所為かな。"
      ],
      "translated_lines": [
        "最近大家都好奇怪哦。",
        "是春天闹的吗。"
      ]
    },
    "80/140_0": {
      "original_lines": [
        "タラッタラッタラッタ、うさぎのダンス～♪"
      ],
      "translated_lines": [
        "嗒啦嗒啦嗒啦嗒，兔子的舞蹈～♪"
      ]
    },
    "80/140_1": {
      "original_lines": [
        "タラッタラッタラッタ、可愛いダンス～♪"
      ],
      "translated_lines": [
        "嗒啦嗒啦嗒啦嗒，可爱的舞蹈～♪"
      ]
    },
    "80/170_0": {
      "original_lines": [
        "えらく陽気な化け鳥が現れたもんね。"
      ],
      "translated_lines": [
        "跑来了一个好活泼的怪鸟哦。"
      ]
    },
    "80/171_0": {
      "original_lines": [
        "兎はお呼びでない。"
      ],
      "translated_lines": [
        "我没叫你这个兔子啦。"
      ]
    },
    "80/172_0": {
      "original_lines": [
        "兎の歌を歌ってたじゃないの。"
      ],
      "translated_lines": [
        "你不是在唱兔子歌吗。"
      ]
    },
    "81/50_0": {
      "original_lines": [
        "何処まで飛んでも景色が変わらなーい。"
      ],
      "translated_lines": [
        "飞到哪里都是一个样子啦。"
      ]
    },
    "82/50_0": {
      "original_lines": [
        "雀になんかに幸運を分けてやらないからね！"
      ],
      "translated_lines": [
        "我才不会把幸运分给一只麻雀呢！"
      ]
    },
    "60/140_0": {
      "original_lines": [
        "お空の上はマッハの時代～♪",
        "文明開化の味がする～♪"
      ],
      "translated_lines": [
        "天上是音速的时代～♪",
        "还有那文明开化的味道～♪"
      ]
    },
    "60/140_1": {
      "original_lines": [
        "珍しいねぇ。"
      ],
      "translated_lines": [
        "真稀奇啊。"
      ]
    },
    "60/170_0": {
      "original_lines": [
        "こんな小鳥が雲の上までやってくるなんて。"
      ],
      "translated_lines": [
        "这样的小鸟还能飞到云上面。"
      ]
    },
    "60/171_0": {
      "original_lines": [
        "あれ？",
        "妙に晴れてると思ったら雲の上じゃん。"
      ],
      "translated_lines": [
        "哎？",
        "突然觉得天一下放晴了，原来已经到云上了。"
      ]
    },
    "60/172_0": {
      "original_lines": [
        "通りで羽が冷たいと思ったわ～♪"
      ],
      "translated_lines": [
        "怪不得羽毛一下变得这么冷～♪"
      ]
    },
    "60/173_0": {
      "original_lines": [
        "音楽で勝負して負けたいのね？"
      ],
      "translated_lines": [
        "想在音乐对决里输给我吗？"
      ]
    },
    "61/50_0": {
      "original_lines": [
        "こんな雲の上じゃあ、人間が通りそうも無い",
        "じゃないの。"
      ],
      "translated_lines": [
        "云上也不像会有人的",
        "样子嘛。"
      ]
    },
    "62/50_0": {
      "original_lines": [
        "ああ、鳥が墜ちていく風切り音も",
        "なかなかに幻想的で素敵ね。"
      ],
      "translated_lines": [
        "啊啊，鸟儿坠落下云端的声音还真是富有幻想，",
        "很美妙哦。"
      ]
    },
    "30/140_0": {
      "original_lines": [
        "もういーくつねるとー、おーしょうがつー♪"
      ],
      "translated_lines": [
        "新年了～，快快起床了～♪"
      ]
    },
    "30/140_1": {
      "original_lines": [
        "気の早い歌が聞こえてくる……"
      ],
      "translated_lines": [
        "这么早就有歌飘过来……"
      ]
    },
    "30/170_0": {
      "original_lines": [
        "まだ春だから、結構寝ないと正月は来ないわ、",
        "ってどこから歌が聞こえるのかしら？"
      ],
      "translated_lines": [
        "现在还是春天呢，不多睡一下的话",
        "正月是不会来的，这歌是从哪里来的？"
      ]
    },
    "30/171_0": {
      "original_lines": [
        "いいや、人間は一回寝ればお正月！"
      ],
      "translated_lines": [
        "不会啊，人只要睡一次，醒过来就是正月了！"
      ]
    },
    "30/172_0": {
      "original_lines": [
        "む。化け物のたぐいね！"
      ],
      "translated_lines": [
        "啊，你这个妖怪！"
      ]
    },
    "31/50_0": {
      "original_lines": [
        "この道で一回眠れば、",
        "もう次の正月まで眼を覚ますことはないわー"
      ],
      "translated_lines": [
        "在这条路上睡一次，",
        "不到正月我才不起来呢…"
      ]
    },
    "32/50_0": {
      "original_lines": [
        "なんだ、鳥か……",
        "焦って損したわ。"
      ],
      "translated_lines": [
        "什么嘛，原来是只鸟啊……",
        "白着急了。"
      ]
    },
    "40/140_0": {
      "original_lines": [
        "何をおっしゃる、うっさぎさん～♪"
      ],
      "translated_lines": [
        "你在说什么，小兔子～♪"
      ]
    },
    "40/140_1": {
      "original_lines": [
        "誰……？"
      ],
      "translated_lines": [
        "是谁……？"
      ]
    },
    "40/170_0": {
      "original_lines": [
        "何か、歌声のような会話の様な声が",
        "聞こえたけど……"
      ],
      "translated_lines": [
        "刚才好像听到了",
        "类似歌声一样的话……"
      ]
    },
    "40/171_0": {
      "original_lines": [
        "地上を這う生き物は、空を飛ぶ生き物には",
        "敵わないよ。"
      ],
      "translated_lines": [
        "地上爬的生物，是比不过",
        "飞天的生物哦。"
      ]
    },
    "40/172_0": {
      "original_lines": [
        "小鳥の襲撃！？"
      ],
      "translated_lines": [
        "小鸟的袭击！？"
      ]
    },
    "41/50_0": {
      "original_lines": [
        "人間通らないなぁ……"
      ],
      "translated_lines": [
        "附近没有人啊……"
      ]
    },
    "42/50_0": {
      "original_lines": [
        "この辺の化け鳥も浮かれているわね。",
        "今日は鳥鍋かしら？"
      ],
      "translated_lines": [
        "最近附近的怪鸟都变傻了呢。",
        "今天做鸟肉火锅吧？"
      ]
    },
    "10/140_0": {
      "original_lines": [
        "悲しみに包まれて妖精郷はぁ～",
        "肥沃な黒土で覆われた～♪"
      ],
      "translated_lines": [
        "被悲伤包围的幻想乡～",
        "覆盖着肥沃的黑土～♪"
      ]
    },
    "10/140_1": {
      "original_lines": [
        "ロックだな。"
      ],
      "translated_lines": [
        "你在唱摇滚吗。"
      ]
    },
    "10/170_0": {
      "original_lines": [
        "でも、少し五月蝿いぜ。"
      ],
      "translated_lines": [
        "可是有点吵啊。"
      ]
    },
    "10/171_0": {
      "original_lines": [
        "五月蝿い五月蝿いも静かなうちよ～"
      ],
      "translated_lines": [
        "吵啊，吵啊，我想要个安静的家～"
      ]
    },
    "10/172_0": {
      "original_lines": [
        "五月蝿い黙れ！"
      ],
      "translated_lines": [
        "吵死了！闭嘴！"
      ]
    },
    "11/50_0": {
      "original_lines": [
        "歌が静かじゃ、お経の方がマシってもんよ！"
      ],
      "translated_lines": [
        "要是你觉得唱歌能安静，那你还不如去念经！"
      ]
    },
    "12/50_0": {
      "original_lines": [
        "折角花見で騒ごうと思ってるのに、先に騒がれ",
        "ていると萎えるじゃないか。"
      ],
      "translated_lines": [
        "好不容易想去赏花热闹一下，还没开始",
        "就这么热闹，真是扫兴。"
      ]
    },
    "20/140_0": {
      "original_lines": [
        "ヒトッ、ヒトッ、ヒトをッ！",
        "人間を～さらえぇ♪"
      ],
      "translated_lines": [
        "抓人～抓人～抓人了～",
        "把人类～抓走♪"
      ]
    },
    "20/140_1": {
      "original_lines": [
        "春よねぇ。"
      ],
      "translated_lines": [
        "春天到了啊。"
      ]
    },
    "20/170_0": {
      "original_lines": [
        "妖怪もおかしな妖怪ばっかね。"
      ],
      "translated_lines": [
        "妖怪也都变得奇怪了。"
      ]
    },
    "20/171_0": {
      "original_lines": [
        "人間を喰うのは妖怪の務め！",
        "さてはあんたは人間ね？"
      ],
      "translated_lines": [
        "吃人是妖怪的义务！",
        "你也是人类吧？"
      ]
    },
    "20/172_0": {
      "original_lines": [
        "残念、妖怪を退治するメイドでした。"
      ],
      "translated_lines": [
        "不好意思，我是除妖的女仆。"
      ]
    },
    "21/50_0": {
      "original_lines": [
        "メイドかぁ、残念。",
        "さらうなら人間が良いなぁ。"
      ],
      "translated_lines": [
        "女仆啊，真没意思。",
        "要是个人类就好了。"
      ]
    },
    "22/50_0": {
      "original_lines": [
        "この花で覆われた幻想郷。",
        "こんな妖怪ばかりだと思うとうんざりするわ。"
      ],
      "translated_lines": [
        "这个花开的幻想乡里。",
        "要是全是这样的妖怪，我就该疯了。"
      ]
    },
    "0/140_0": {
      "original_lines": [
        "そこのけそこのけ鳥さん力持ち～♪"
      ],
      "translated_lines": [
        "让开路～让开路～给强大的鸟儿让开路～♪"
      ]
    },
    "0/140_1": {
      "original_lines": [
        "何よそれ。"
      ],
      "translated_lines": [
        "什么啊。"
      ]
    },
    "0/170_0": {
      "original_lines": [
        "昼間から不穏な歌、歌ってんじゃないわよ。"
      ],
      "translated_lines": [
        "大白天不要唱这种无聊的歌啦"
      ]
    },
    "0/171_0": {
      "original_lines": [
        "花見には歌がつきものなのよ～♪"
      ],
      "translated_lines": [
        "赏花的时候怎么可以不唱歌呢～♪"
      ]
    },
    "0/172_0": {
      "original_lines": [
        "歌って答えるな。"
      ],
      "translated_lines": [
        "不要唱着回答。"
      ]
    },
    "1/50_0": {
      "original_lines": [
        "私の歌が聞こえる範囲内に入ったことが、",
        "あんたの敗因よ。"
      ],
      "translated_lines": [
        "跑到能听到我的歌的范围里，",
        "是你的败因哦。"
      ]
    },
    "2/50_0": {
      "original_lines": [
        "鳥さん大往生～♪",
        "あら、うつっちゃった。"
      ],
      "translated_lines": [
        "鸟儿去见你的祖先吧～♪",
        "哎呀，我也在唱了"
      ]
    },
    "3/140_0": {
      "original_lines": [
        "この辺も行き飽きたわね～♪"
      ],
      "translated_lines": [
        "这附近已经转够了～♪"
      ]
    },
    "3/140_1": {
      "original_lines": [
        "おかしいわ。"
      ],
      "translated_lines": [
        "真奇怪"
      ]
    },
    "3/170_0": {
      "original_lines": [
        "何処に行っても異変に大差ないなんて……",
        "って、鳥？"
      ],
      "translated_lines": [
        "无论哪里的异样都差不多呢……",
        "鸟？"
      ]
    },
    "3/171_0": {
      "original_lines": [
        "そう、何処に行っても大差ないのか～"
      ],
      "translated_lines": [
        "是啊，无论哪里都是一样吗～"
      ]
    },
    "3/172_0": {
      "original_lines": [
        "もう、鳥とか妖精とか兎とか……",
        "そんなんばっかだわ！"
      ],
      "translated_lines": [
        "不管了啦，鸟、妖精和兔子……",
        "尽是这些啦！"
      ]
    },
    "4/50_0": {
      "original_lines": [
        "何処に行っても大差ないのなら、普段は",
        "行かない所に行っても面白そうね～。"
      ],
      "translated_lines": [
        "要是去哪里都一样的话，不如到平时不去的地方",
        "去看看更有趣哦～。"
      ]
    },
    "4/51_0": {
      "original_lines": [
        "普段は人間は居ないから行かないんだけど。"
      ],
      "translated_lines": [
        "虽然平时没有人的地方根本不会去了啦。"
      ]
    },
    "5/50_0": {
      "original_lines": [
        "この辺じゃ無いのかなぁ。",
        "異変の犯人が居る場所って……"
      ],
      "translated_lines": [
        "这个附近也没有啊。",
        "造成异变的犯人……"
      ]
    },
    "110/140_0": {
      "original_lines": [
        "翼が傷つき倒れても～♪"
      ],
      "translated_lines": [
        "就算翅膀受伤倒下～♪"
      ]
    },
    "110/141_0": {
      "original_lines": [
        "ここでは寝るな～鈴蘭の夢～♪"
      ],
      "translated_lines": [
        "也不要睡在这里～铃兰的梦～♪"
      ]
    },
    "110/141_1": {
      "original_lines": [
        "騒々しいわね"
      ],
      "translated_lines": [
        "吵死了啦"
      ]
    },
    "110/171_0": {
      "original_lines": [
        "お花畑に歌いながらやってくる奴なんて、",
        "変態か変質者位よね。"
      ],
      "translated_lines": [
        "边唱歌边飞到花田来的家伙，",
        "不是傻瓜就是变态吧。"
      ]
    },
    "110/172_0": {
      "original_lines": [
        "歌の邪魔をする奴が多すぎるぅ。",
        "歌い続けないと死んじゃうんだから仕方がない"
      ],
      "translated_lines": [
        "打扰人家唱歌的家伙太多了哩。",
        "不唱就会死人的，没办法啦"
      ]
    },
    "110/173_0": {
      "original_lines": [
        "嘘ばっかり。",
        "そんな訳ないじゃん。"
      ],
      "translated_lines": [
        "说谎。",
        "这怎么可能。"
      ]
    },
    "110/174_0": {
      "original_lines": [
        "それに、そういう事言う奴はもっと儚い歌を",
        "歌うもんよ。"
      ],
      "translated_lines": [
        "而且说这些话的家伙都只会唱一些",
        "更虚幻的歌。"
      ]
    },
    "110/175_0": {
      "original_lines": [
        "何よその激しい歌は。",
        "何よその元気な歌は。"
      ],
      "translated_lines": [
        "你那些激烈的歌算什么啦。",
        "你那些活泼的歌又算什么啦。"
      ]
    },
    "110/176_0": {
      "original_lines": [
        "歌は元気の元。"
      ],
      "translated_lines": [
        "歌是精神的源泉哦。"
      ]
    },
    "110/177_0": {
      "original_lines": [
        "悲しい歌なんか歌って感傷的になってるん",
        "じゃないわよ。"
      ],
      "translated_lines": [
        "唱这些悲伤的歌还让人这么忧伤。"
      ]
    },
    "110/178_0": {
      "original_lines": [
        "自殺したくなる様な歌なんて以ての外！"
      ],
      "translated_lines": [
        "还会让人去自杀，我才不要！"
      ]
    },
    "110/179_0": {
      "original_lines": [
        "でもー疲れるわー貴方の歌。"
      ],
      "translated_lines": [
        "可是你的歌我都听厌了呢。"
      ]
    },
    "110/180_0": {
      "original_lines": [
        "じゃ、元気が回復する歌を歌うわ。",
        "鈴蘭の毒が～♪"
      ],
      "translated_lines": [
        "那，我来给你唱恢复精神的歌吧。",
        "铃兰的毒～♪"
      ]
    },
    "110/181_0": {
      "original_lines": [
        "歌うな！"
      ],
      "translated_lines": [
        "不许唱！"
      ]
    },
    "110/182_0": {
      "original_lines": [
        "傷ついた翼にまわる～……",
        "って、あ、あれー……"
      ],
      "translated_lines": [
        "盘旋在我受伤的翅膀……",
        "啊，哎……"
      ]
    },
    "110/183_0": {
      "original_lines": [
        "ふふふ、ようやく毒がまわってきたようね。"
      ],
      "translated_lines": [
        "呵呵呵，终于让你染上毒了呢。"
      ]
    },
    "110/184_0": {
      "original_lines": [
        "毒を受けやすい大きな翼と、ちょこまか動く",
        "無鉄砲さがあだとなる。"
      ],
      "translated_lines": [
        "容易中毒的翅膀，稍微动一动",
        "就会让冒失鬼中毒哦。"
      ]
    },
    "110/185_0": {
      "original_lines": [
        "さあ、鈴蘭の丘で毒の優しさに包まれて",
        "眠りなさい！"
      ],
      "translated_lines": [
        "来吧，在这片铃兰的山丘上被温柔的毒包裹着",
        "睡去吧！"
      ]
    },
    "111/50_0": {
      "original_lines": [
